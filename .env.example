# Server
PORT=5000
CLIENT_URL=https://your-app-domain.com
JWT_SECRET=replace_with_a_long_random_string

# MongoDB
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/guntur_kaaram

# Google OAuth (console.cloud.google.com > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://your-api-domain.com/api/auth/google/callback

# Facebook OAuth (developers.facebook.com > My Apps)
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_CALLBACK_URL=https://your-api-domain.com/api/auth/facebook/callback

# Razorpay (dashboard.razorpay.com > Settings > API Keys)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# WhatsApp Cloud API (developers.facebook.com/docs/whatsapp/cloud-api)
WHATSAPP_TOKEN=your_meta_whatsapp_cloud_api_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=choose_any_string_for_webhook_verification
